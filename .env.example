# ==========================================================
# TAHAP 6 - FIREBASE SERVER BACKEND
# ==========================================================
# Server-only. NEVER prefix service account values with NEXT_PUBLIC_.
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY\n-----END PRIVATE KEY-----\n"

# Used to sign secure HttpOnly admin/customer sessions and OTP hashes.
# Generate with: npm run firebase:secret
SESSION_SECRET=

# Admin login remains server-side scrypt so the UI/login flow does not change.
ADMIN_EMAIL=kastriva01@gmail.com
ADMIN_PASSWORD_SCRYPT=scrypt-v1$SALT$HASH

# Public settings
NEXT_PUBLIC_SITE_URL=https://kastriva-portfolio.vercel.app
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# ==========================================================
# TEMPORARY ONLY FOR ONE-TIME GAS -> FIREBASE DATA MIGRATION
# Not required by production after migration is verified.
# ==========================================================
GAS_API_URL=https://script.google.com/macros/s/DEPLOYMENT_ID/exec
GAS_BRIDGE_SECRET=
